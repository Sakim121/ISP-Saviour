# --- VSOL V1600D8 connection (read-only SNMP) ---
# Defaults below match the Phase 7 spec exactly. Override only if your
# actual unit's IP/port/community differs.
OLT_HOST=192.168.80.2
OLT_PORT=161
SNMP_COMMUNITY=public

# --- Supabase ---
# MUST be the service_role key, not the anon key. Never commit this file
# with a real key filled in.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Scan loop ---
SCAN_INTERVAL_MS=60000
