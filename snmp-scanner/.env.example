# --- OLT connection (read-only SNMP) ---
OLT_HOST=192.168.80.2
OLT_PORT=161
SNMP_COMMUNITY=public
# One of: generic, vsol, netlink, syrotech — selects the OID set from src/oids.js.
# See README "OID Verification" before relying on any of these in production.
OLT_BRAND=generic

# --- Supabase ---
# MUST be the service_role key, not the anon key — this script writes to
# the `nodes` table and needs to bypass RLS. Never commit this file with a
# real key filled in, and never expose this key to a browser/frontend.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Scan loop ---
SCAN_INTERVAL_MS=60000
